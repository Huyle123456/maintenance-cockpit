<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified"
>
    <Dialog
        id="importOrdersDialog"
        title="{i18n>importOrdersDialogTitle}"
        icon="sap-icon://excel-attachment"
        contentWidth="900px"
        contentHeight="550px"
        resizable="true"
        draggable="true"
    >
        <content>
            <VBox class="sapUiSmallMargin">
                <!-- File Upload Bar -->
                <HBox
                    alignItems="Center"
                    justifyContent="SpaceBetween"
                    class="sapUiSmallMarginBottom"
                    width="100%"
                >
                    <HBox
                        alignItems="Center"
                        width="70%"
                    >
                        <Label
                            text="{i18n>importOrdersUploadLabel}"
                            design="Bold"
                            class="sapUiSmallMarginEnd"
                        />
                        <u:FileUploader
                            id="orderFileUploader"
                            name="orderFileUploader"
                            fileType="xlsx,xls,csv"
                            mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,text/csv"
                            placeholder="{i18n>importOrdersUploadPlaceholder}"
                            change=".onImportFileChange"
                            width="320px"
                            buttonOnly="false"
                            buttonText="Browse..."
                            icon="sap-icon://attachment"
                            class="sapUiTinyMarginEnd"
                        />
                    </HBox>

                    <Button
                        id="btnDownloadTemplate"
                        text="{i18n>importOrdersDownloadTemplate}"
                        icon="sap-icon://download"
                        type="Transparent"
                        press=".onDownloadImportTemplate"
                    />
                </HBox>

                <!-- Information Message Strip -->
                <MessageStrip
                    id="importOrdersMessageStrip"
                    text="{importModel>/statusMessage}"
                    type="{importModel>/statusType}"
                    showIcon="true"
                    showCloseButton="false"
                    visible="{= !!${importModel>/statusMessage} }"
                    class="sapUiSmallMarginBottom"
                />

                <!-- Preview Table Card -->
                <Table
                    id="tblImportPreview"
                    items="{importModel>/previewRows}"
                    noDataText="Upload a .xlsx or .csv file to preview orders"
                    growing="true"
                    growingThreshold="20"
                    class="sapUiNoContentPadding"
                >
                    <headerToolbar>
                        <OverflowToolbar id="importPreviewToolbar">
                            <Title
                                text="{parts: [{path: 'i18n>importOrdersPreviewTitle'}, {path: 'importModel>/previewRowCount'}], formatter: 'jQuery.sap.formatMessage'}"
                                level="H5"
                            />
                            <ToolbarSpacer />
                            <ObjectStatus
                                text="{importModel>/validCountText}"
                                state="Success"
                                inverted="true"
                                visible="{= ${importModel>/previewRowCount} > 0 }"
                            />
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column width="110px">
                            <Text text="Order" />
                        </Column>
                        <Column width="110px">
                            <Text text="Equipment" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true">
                            <Text text="Description" />
                        </Column>
                        <Column width="80px" minScreenWidth="Desktop" demandPopin="true">
                            <Text text="Plant" />
                        </Column>
                        <Column width="110px" minScreenWidth="Desktop" demandPopin="true">
                            <Text text="Type" />
                        </Column>
                        <Column width="90px">
                            <Text text="Priority" />
                        </Column>
                        <Column width="110px" minScreenWidth="Desktop" demandPopin="true">
                            <Text text="Planner" />
                        </Column>
                        <Column width="110px" minScreenWidth="Desktop" demandPopin="true">
                            <Text text="Schedule" />
                        </Column>
                        <Column width="100px" hAlign="End">
                            <Text text="Status" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <ObjectIdentifier title="{importModel>order}" />
                                <Text text="{importModel>equipment}" />
                                <Text text="{importModel>description}" />
                                <Text text="{importModel>plant}" />
                                <Text text="{importModel>type}" />
                                <ObjectStatus
                                    text="{importModel>priority}"
                                    state="{importModel>priorityState}"
                                />
                                <Text text="{importModel>planner}" />
                                <Text text="{importModel>scheduled}" />
                                <ObjectStatus
                                    text="{importModel>validationText}"
                                    state="{importModel>validationState}"
                                    inverted="true"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
        <beginButton>
            <Button
                id="btnConfirmImport"
                text="{i18n>importOrdersConfirmButton}"
                type="Emphasized"
                icon="sap-icon://upload"
                enabled="{importModel>/canImport}"
                press=".onConfirmImportOrders"
            />
        </beginButton>
        <endButton>
            <Button
                id="btnCancelImport"
                text="{i18n>commonCancel}"
                press=".onCancelImportOrders"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
