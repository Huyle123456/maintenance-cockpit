VIEW MaintenanceService_AuditHistory AS SELECT
  AuditHistory_0.ID,
  AuditHistory_0.createdAt,
  AuditHistory_0.createdBy,
  AuditHistory_0.modifiedAt,
  AuditHistory_0.modifiedBy,
  AuditHistory_0."TIMESTAMP",
  AuditHistory_0."USER",
  AuditHistory_0.object,
  AuditHistory_0.action,
  AuditHistory_0.details
FROM sap_cap_maintenance_AuditHistory AS AuditHistory_0