VIEW MaintenanceService_Equipments AS SELECT
  Equipments_0.createdAt,
  Equipments_0.createdBy,
  Equipments_0.modifiedAt,
  Equipments_0.modifiedBy,
  Equipments_0.equipment,
  Equipments_0.description,
  Equipments_0.type,
  Equipments_0.plant,
  Equipments_0.location,
  Equipments_0.status,
  Equipments_0.criticality,
  Equipments_0.manufacturer
FROM sap_cap_maintenance_Equipments AS Equipments_0