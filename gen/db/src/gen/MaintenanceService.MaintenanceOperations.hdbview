VIEW MaintenanceService_MaintenanceOperations AS SELECT
  MaintenanceOperations_0.createdAt,
  MaintenanceOperations_0.createdBy,
  MaintenanceOperations_0.modifiedAt,
  MaintenanceOperations_0.modifiedBy,
  MaintenanceOperations_0.order_no,
  MaintenanceOperations_0."NO",
  MaintenanceOperations_0.description,
  MaintenanceOperations_0.workCenter,
  MaintenanceOperations_0.technician,
  MaintenanceOperations_0.plannedHours,
  MaintenanceOperations_0.actualHours,
  MaintenanceOperations_0.status
FROM sap_cap_maintenance_MaintenanceOperations AS MaintenanceOperations_0