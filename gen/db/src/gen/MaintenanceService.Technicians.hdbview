VIEW MaintenanceService_Technicians AS SELECT
  Technicians_0.createdAt,
  Technicians_0.createdBy,
  Technicians_0.modifiedAt,
  Technicians_0.modifiedBy,
  Technicians_0.key,
  Technicians_0."TEXT",
  Technicians_0.employee,
  Technicians_0.name,
  Technicians_0.skill,
  Technicians_0.workCenter,
  Technicians_0.available
FROM sap_cap_maintenance_Technicians AS Technicians_0