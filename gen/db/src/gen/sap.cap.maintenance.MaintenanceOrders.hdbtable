COLUMN TABLE sap_cap_maintenance_MaintenanceOrders (
  createdAt TIMESTAMP,
  createdBy NVARCHAR(255),
  modifiedAt TIMESTAMP,
  modifiedBy NVARCHAR(255),
  order_no NVARCHAR(20) NOT NULL,
  equipment_no NVARCHAR(20),
  description NVARCHAR(255),
  plant NVARCHAR(10),
  maintenance_type NVARCHAR(50),
  priority NVARCHAR(20),
  priority_state NVARCHAR(20),
  status NVARCHAR(20),
  status_state NVARCHAR(20),
  planner NVARCHAR(100),
  scheduled_from DATE,
  scheduled_to DATE,
  location NVARCHAR(255),
  work_center NVARCHAR(50),
  operation_count INTEGER DEFAULT 0,
  completed_operation_count INTEGER DEFAULT 0,
  planned_hours DECIMAL(10, 2) DEFAULT 0.0,
  actual_hours DECIMAL(10, 2) DEFAULT 0.0,
  estimated_cost DECIMAL(15, 2) DEFAULT 0.0,
  currency NVARCHAR(5) DEFAULT 'USD',
  etag NVARCHAR(50),
  PRIMARY KEY(order_no)
)