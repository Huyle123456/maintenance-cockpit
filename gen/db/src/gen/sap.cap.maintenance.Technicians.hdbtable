COLUMN TABLE sap_cap_maintenance_Technicians (
  createdAt TIMESTAMP,
  createdBy NVARCHAR(255),
  modifiedAt TIMESTAMP,
  modifiedBy NVARCHAR(255),
  key NVARCHAR(20) NOT NULL,
  "TEXT" NVARCHAR(100),
  employee NVARCHAR(20),
  name NVARCHAR(100),
  skill NVARCHAR(100),
  workCenter NVARCHAR(50),
  available NVARCHAR(10),
  PRIMARY KEY(key)
)