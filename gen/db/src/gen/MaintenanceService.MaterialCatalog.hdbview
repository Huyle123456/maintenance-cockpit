VIEW MaintenanceService_MaterialCatalog AS SELECT
  MaterialCatalog_0.createdAt,
  MaterialCatalog_0.createdBy,
  MaterialCatalog_0.modifiedAt,
  MaterialCatalog_0.modifiedBy,
  MaterialCatalog_0.key,
  MaterialCatalog_0.description,
  MaterialCatalog_0.unit,
  MaterialCatalog_0.availableStock,
  MaterialCatalog_0.unitPrice
FROM sap_cap_maintenance_MaterialCatalog AS MaterialCatalog_0