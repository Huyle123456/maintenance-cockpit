VIEW MaintenanceService_OrderHistory AS SELECT
  OrderHistory_0.ID,
  OrderHistory_0.createdAt,
  OrderHistory_0.createdBy,
  OrderHistory_0.modifiedAt,
  OrderHistory_0.modifiedBy,
  OrderHistory_0.order_no,
  OrderHistory_0.title,
  OrderHistory_0."DATETIME",
  OrderHistory_0.userName,
  OrderHistory_0."TEXT",
  OrderHistory_0.icon
FROM sap_cap_maintenance_OrderHistory AS OrderHistory_0