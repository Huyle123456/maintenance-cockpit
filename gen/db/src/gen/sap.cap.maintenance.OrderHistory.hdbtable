COLUMN TABLE sap_cap_maintenance_OrderHistory (
  ID NVARCHAR(36) NOT NULL,
  createdAt TIMESTAMP,
  createdBy NVARCHAR(255),
  modifiedAt TIMESTAMP,
  modifiedBy NVARCHAR(255),
  order_no NVARCHAR(20),
  title NVARCHAR(255),
  "DATETIME" NVARCHAR(50),
  userName NVARCHAR(100),
  "TEXT" NVARCHAR(500),
  icon NVARCHAR(100),
  PRIMARY KEY(ID)
)