COLUMN TABLE sap_cap_maintenance_MaintenanceOperations (
  createdAt TIMESTAMP,
  createdBy NVARCHAR(255),
  modifiedAt TIMESTAMP,
  modifiedBy NVARCHAR(255),
  order_no NVARCHAR(20) NOT NULL,
  "NO" NVARCHAR(10) NOT NULL,
  description NVARCHAR(255),
  workCenter NVARCHAR(50),
  technician NVARCHAR(50),
  plannedHours DECIMAL(10, 2) DEFAULT 0.0,
  actualHours DECIMAL(10, 2) DEFAULT 0.0,
  status NVARCHAR(20),
  PRIMARY KEY(order_no, "NO")
)