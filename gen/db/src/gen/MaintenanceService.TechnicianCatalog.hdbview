VIEW MaintenanceService_TechnicianCatalog AS SELECT
  TechnicianCatalog_0.createdAt,
  TechnicianCatalog_0.createdBy,
  TechnicianCatalog_0.modifiedAt,
  TechnicianCatalog_0.modifiedBy,
  TechnicianCatalog_0.key,
  TechnicianCatalog_0.name,
  TechnicianCatalog_0.skill,
  TechnicianCatalog_0.workCenter,
  TechnicianCatalog_0.available
FROM sap_cap_maintenance_TechnicianCatalog AS TechnicianCatalog_0