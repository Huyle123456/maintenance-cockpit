VIEW MaintenanceService_Materials AS SELECT
  Materials_0.createdAt,
  Materials_0.createdBy,
  Materials_0.modifiedAt,
  Materials_0.modifiedBy,
  Materials_0.material,
  Materials_0.description,
  Materials_0.qty,
  Materials_0.unit,
  Materials_0.availableStock,
  Materials_0.value
FROM sap_cap_maintenance_Materials AS Materials_0