{
  "format_version": 1,
  "imports": [
    {
      "target_table": "SAP_CAP_MAINTENANCE_MATERIALS",
      "source_data": {
        "data_type": "CSV",
        "file_name": "sap.cap.maintenance-Materials.csv",
        "has_header": true,
        "type_config": {
          "delimiter": ";"
        }
      },
      "import_settings": {
        "import_columns": [
          "MATERIAL",
          "DESCRIPTION",
          "QTY",
          "UNIT",
          "AVAILABLESTOCK",
          "VALUE"
        ],
        "include_filter": []
      },
      "column_mappings": {
        "MATERIAL": "material",
        "DESCRIPTION": "description",
        "QTY": "qty",
        "UNIT": "unit",
        "AVAILABLESTOCK": "availableStock",
        "VALUE": "value"
      }
    }
  ]
}