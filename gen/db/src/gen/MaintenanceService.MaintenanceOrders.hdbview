VIEW MaintenanceService_MaintenanceOrders AS SELECT
  MaintenanceOrders_0.createdAt,
  MaintenanceOrders_0.createdBy,
  MaintenanceOrders_0.modifiedAt,
  MaintenanceOrders_0.modifiedBy,
  MaintenanceOrders_0.order_no,
  MaintenanceOrders_0.equipment_no,
  MaintenanceOrders_0.description,
  MaintenanceOrders_0.plant,
  MaintenanceOrders_0.maintenance_type,
  MaintenanceOrders_0.priority,
  MaintenanceOrders_0.priority_state,
  MaintenanceOrders_0.status,
  MaintenanceOrders_0.status_state,
  MaintenanceOrders_0.planner,
  MaintenanceOrders_0.scheduled_from,
  MaintenanceOrders_0.scheduled_to,
  MaintenanceOrders_0.location,
  MaintenanceOrders_0.work_center,
  MaintenanceOrders_0.operation_count,
  MaintenanceOrders_0.completed_operation_count,
  MaintenanceOrders_0.planned_hours,
  MaintenanceOrders_0.actual_hours,
  MaintenanceOrders_0.estimated_cost,
  MaintenanceOrders_0.currency,
  MaintenanceOrders_0.etag
FROM sap_cap_maintenance_MaintenanceOrders AS MaintenanceOrders_0