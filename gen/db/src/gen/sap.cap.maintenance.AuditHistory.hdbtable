COLUMN TABLE sap_cap_maintenance_AuditHistory (
  ID NVARCHAR(36) NOT NULL,
  createdAt TIMESTAMP,
  createdBy NVARCHAR(255),
  modifiedAt TIMESTAMP,
  modifiedBy NVARCHAR(255),
  "TIMESTAMP" NVARCHAR(50),
  "USER" NVARCHAR(100),
  object NVARCHAR(50),
  action NVARCHAR(50),
  details NVARCHAR(500),
  PRIMARY KEY(ID)
)